{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0xatlas96/ai-spend-guard/main/schema/ai-spend-firewall.schema.json",
  "title": "AI Spend Guard Firewall Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policies"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "unknownEstimate": {
      "enum": [
        "deny",
        "allow"
      ],
      "default": "deny"
    },
    "defaultProvider": {
      "type": "string",
      "minLength": 1
    },
    "staleAfterMs": {
      "type": "number",
      "minimum": 0
    },
    "ledgerPath": {
      "type": "string",
      "minLength": 1
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "requiredContext": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(provider|model|resource|projectId|userId|sessionId|agentId|route|environment|tag:.+)$"
      }
    }
  },
  "$defs": {
    "matchValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "$ref": "#/$defs/matchValue"
        },
        "model": {
          "$ref": "#/$defs/matchValue"
        },
        "resource": {
          "$ref": "#/$defs/matchValue"
        },
        "projectId": {
          "$ref": "#/$defs/matchValue"
        },
        "userId": {
          "$ref": "#/$defs/matchValue"
        },
        "sessionId": {
          "$ref": "#/$defs/matchValue"
        },
        "agentId": {
          "$ref": "#/$defs/matchValue"
        },
        "route": {
          "$ref": "#/$defs/matchValue"
        },
        "environment": {
          "$ref": "#/$defs/matchValue"
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/matchValue"
          }
        }
      }
    },
    "window": {
      "oneOf": [
        {
          "enum": [
            "utc-day",
            "utc-month",
            "lifetime"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rollingMs"
          ],
          "properties": {
            "rollingMs": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "groupBy": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(provider|model|resource|projectId|userId|sessionId|agentId|route|environment|tag:.+)$"
          }
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "limitUsd": {
          "type": "number",
          "minimum": 0
        },
        "limitCalls": {
          "type": "integer",
          "minimum": 0
        },
        "maxOperationUsd": {
          "type": "number",
          "minimum": 0
        },
        "maxConcurrent": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "enum": [
            "enforce",
            "observe"
          ]
        },
        "warnAt": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "limitUsd"
          ]
        },
        {
          "required": [
            "limitCalls"
          ]
        },
        {
          "required": [
            "maxOperationUsd"
          ]
        },
        {
          "required": [
            "maxConcurrent"
          ]
        }
      ]
    }
  }
}
